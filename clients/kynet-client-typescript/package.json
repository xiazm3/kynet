{
  "name": "@kynet/client",
  "version": "0.1.0",
  "description": "Portable Kynet gateway client for TypeScript, browsers and Node.js",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "example": "npm run build && node examples/login.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=20.3" },
  "dependencies": { "long": "^5.3.2", "protobufjs": "^7.5.4", "ws": "^8.18.3" },
  "devDependencies": { "@types/node": "^22.18.0", "@types/ws": "^8.18.1", "typescript": "^5.9.2", "esbuild": "^0.25.9" }
}
